<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:ChatCore"
             x:Class="ChatClient.Cross.MainView"
             Background="#1E1F22">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
    <StackPanel Spacing="4">
      <TextBlock Text="Анонимный чат" FontSize="22" FontWeight="SemiBold" Foreground="#F2F3F5"/>
      <TextBlock Text="Windows, macOS, Linux и Android. Голос и видео пока только в клиенте WPF."
                 Foreground="#949BA4" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,10">
      <TextBox x:Name="HubUrl" Watermark="http://host:8080/chat" Text="http://179.66.184.184:8080/chat"/>
      <Button Grid.Column="1" Margin="8,0,0,0" Content="Подключиться" Click="Connect_Click"/>
      <Button Grid.Column="2" Margin="8,0,0,0" x:Name="FindButton" Content="Найти" Click="Find_Click" IsEnabled="False"/>
    </Grid>

    <Border Grid.Row="2" Background="#2B2D31" CornerRadius="10" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="StatusText" Text="Не подключено" Foreground="#949BA4" Margin="4,0,4,8"/>
        <ScrollViewer>
          <ItemsControl x:Name="Messages">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:ChatLine">
                <Border Padding="10,6" Margin="0,3" CornerRadius="8" Background="#313338">
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#F2F3F5"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBox x:Name="Input" Watermark="Сообщение" KeyDown="Input_KeyDown"/>
      <Button Grid.Column="1" Margin="8,0,0,0" Content="Отправить" Click="Send_Click"/>
    </Grid>
  </Grid>
</UserControl>
