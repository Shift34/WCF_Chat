    <Compile Include="..\ChatClient\Protocol Signal\Streebog.cs" Link="Crypto\Streebog.cs" />
    <Compile Include="..\ChatClient\Protocol Signal\HMAC.cs" Link="Crypto\HMAC.cs" />
